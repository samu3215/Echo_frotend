<!DOCTYPE html>
<html lang="es">
<head>
    <%- include('../partials/head-inicio'); %>
    <link rel="stylesheet" href="/css/tarjeta-publicacion.css">
</head>

<body class="cuerpo-inicio">

    <div class="contenedor-principal-interfaz">

        <%- include('../partials/navegacion-escritorio'); %>
        <%- include('../partials/navegacion-movil'); %>

        <main class="area-contenido-principal py-4">
            <%- include('../partials/alertas'); %>

            <div class="contenedor-feed" style="max-width: 470px; margin: 0 auto;">
                <% if (typeof publicaciones !== 'undefined' && publicaciones.length > 0) { %>
                    
                    <% publicaciones.forEach(pub => { %>
                        <%- include('../partials/tarjeta-publicaciones', { post: pub }) %>
                    <% }); %>

                    <% if (tieneSiguiente) { %>
                        <div id="scroll-trigger" class="text-center my-4" data-origen="inicio" data-usuario="">
                            <div class="spinner-border text-primary" role="status" style="color: #8338ec !important;"></div>
                        </div>
                    <% } %>

                <% } else { %>
                    <div class="contenedor-seccion-vacia text-center py-5">
                        <div class="mensaje-vacio">
                            <i class="bi bi-camera fs-1 mb-3 d-block text-muted"></i>
                            <h5 class="text-muted">Aún no hay publicaciones</h5>
                            <p class="text-muted small m-0">Sigue a otros usuarios para ver sus fotos y videos aquí.</p>
                        </div>
                    </div>
                <% } %>
            </div>
        </main>
    </div>

    <%- include('../partials/modal-opciones-post'); %>
    
    <script src="/js/ubicacion.js"></script>
    <script src="/js/feed.js"></script>
    <script src="/js/comentarios.js"></script>
</body>
</html>