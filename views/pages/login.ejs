<!DOCTYPE html>
<html lang="es">
<head>
<%- include('../partials/head'); %>
</head>

<body class="cuerpo-autenticacion">

    <main class="tarjeta-autenticacion">
        <div class="contenedor-logo-aplicacion">
            <img src="/img/echo.png" alt="" class="imagen-logo-aplicacion">
        </div>

        <h1 class="titulo-autenticacion">Bienvenido</h1>

        <form action="/login" method="POST">
            <div class="grupo-campo">
                <label class="etiqueta-campo">Usuario o correo</label>
                <input type="text" name="nombre_usuario" class="campo-entrada" placeholder="Usuario" required>
            </div>

            <div class="grupo-campo">
                <label class="etiqueta-campo">Contraseña</label>
                <input type="password" name="password" class="campo-entrada" placeholder="Contraseña" required>
            </div>

            <button type="submit" class="boton-principal">
                Iniciar Sesión
            </button>
        </form>

        <%- include('../partials/alertas'); %>

        <div class="seccion-enlaces-pie">
            <div class="mb-2">
                <a href="#" class="texto-secundario text-decoration-none">¿Olvidaste tu contraseña?</a>
            </div>
            <div>
                <span class="texto-secundario">¿No tienes cuenta?</span>
                <a href="/registro/seleccion" class="enlace-principal">Registrarse</a>
            </div>
        </div>
    </main>

</body>
</html>