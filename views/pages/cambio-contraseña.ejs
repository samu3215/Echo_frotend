<!DOCTYPE html>
<html lang="es">
<head>
    <%- include('../partials/head'); %>
</head>
<body class="cuerpo-autenticacion">

    <main class="tarjeta-autenticacion">
        <div class="contenedor-logo-aplicacion">
            <img src="/img/echo.png" alt="Echo" class="imagen-logo-aplicacion">
        </div>

        <div class="text-center mb-3" aria-hidden="true">
            <i class="bi bi-shield-lock icono-seguridad"></i>
        </div>

        <div class="indicador-pasos" aria-label="Progreso de recuperación">
            <span class="paso-bullet activo" data-indicador-paso="1">1</span>
            <span class="linea-paso"></span>
            <span class="paso-bullet" data-indicador-paso="2">2</span>
            <span class="linea-paso"></span>
            <span class="paso-bullet" data-indicador-paso="3">3</span>
        </div>

        <div id="mensaje-recuperacion" class="alert d-none" role="alert" aria-live="polite"></div>

        <section id="paso-1" class="bloque-paso">
            <h1 class="titulo-autenticacion">Recuperar contraseña</h1>
            <p class="subtitulo-autenticacion">Ingresa el correo asociado a tu cuenta para recibir un código.</p>

            <form id="form-solicitar-codigo">
                <% if (locals.usuarioLogueado && locals.usuarioLogueado.email) { %>
                    <input type="hidden" id="email" value="<%= usuarioLogueado.email %>">
                    <div class="aviso-expiracion mb-4 text-center">
                        <i class="bi bi-envelope-check me-2" style="font-size: 1.2rem;"></i>
                        Enviaremos el código a:<br>
                        <strong class="mt-1 d-block"><%= usuarioLogueado.email %></strong>
                    </div>
                    <!-- Botón para cerrar sesión si el usuario quiere usar otra cuenta -->
                    <p class="text-center small"><a href="/logout">¿No eres tú? Cerrar sesión</a></p>
                <% } else { %>
                    <div class="grupo-campo">
                        <label class="etiqueta-campo">Correo electrónico</label>
                        <input type="email" id="email" class="campo-entrada" placeholder="nombre@correo.com" required>
                    </div>
                <% } %>
                <p id="error-solicitud" class="text-danger small text-center" hidden></p>
                <button type="submit" class="boton-principal" id="btn-solicitar">Enviar código</button>
            </form>
        </section>

        <section id="paso-2" class="bloque-paso d-none">
            <h1 class="titulo-autenticacion">Verifica tu correo</h1>
            <p class="subtitulo-autenticacion">Ingresa el código de 6 dígitos que enviamos a <strong id="correo-destino"></strong></p>

            <form id="form-verificar-codigo">
                <div class="grupo-campo text-center">
                    <input type="text" id="codigo" class="campo-entrada campo-codigo mx-auto" placeholder="000000" maxlength="6" inputmode="numeric" style="max-width: 200px; letter-spacing: 0.2em; font-size: 1.2rem;" required>
                </div>
                <p id="error-verificacion" class="text-danger small text-center" hidden></p>
                
                <div class="contenedor-botones-pasos mt-4">
                    <% if (!locals.usuarioLogueado) { %>
                        <!-- Si NO está logueado, le dejamos volver a escribir el correo -->
                        <button type="button" class="boton-secundario" onclick="volverAlPaso1()">Atrás</button>
                    <% } else { %>
                        <!-- Si ESTÁ logueado, el botón reenvía el código al correo fijo -->
                        <button type="button" class="boton-secundario" onclick="reenviarCodigo()">Reenviar</button>
                    <% } %>
                    <button type="submit" class="boton-principal" id="btn-verificar">Verificar código</button>
                </div>
            </form>
        </section>

        <section id="paso-3" class="bloque-paso d-none">
            <h1 class="titulo-autenticacion">Nueva contraseña</h1>
            <p class="subtitulo-autenticacion">Crea una nueva contraseña segura.</p>

            <form id="form-restablecer-contrasena">
                <div class="grupo-campo">
                    <label class="etiqueta-campo">Nueva Contraseña</label>
                    <input type="password" id="nueva-password" class="campo-entrada" required minlength="8">
                </div>
                <div class="grupo-campo">
                    <label class="etiqueta-campo">Confirmar Contraseña</label>
                    <input type="password" id="confirmar-password" class="campo-entrada" required minlength="8">
                </div>
                <p id="error-restablecer" class="text-danger small text-center" hidden></p>
                <button type="submit" class="boton-principal" id="btn-restablecer">Guardar contraseña</button>
            </form>
        </section>

        <div class="seccion-enlaces-pie">
            <a href="/login" class="enlace-principal">
                <i class="bi bi-arrow-left me-1" aria-hidden="true"></i>
                Volver al inicio de sesión
            </a>
        </div>
    </main>

    <script src="/js/recuperacion-contrasena.js"></script>
</body>
</html>
