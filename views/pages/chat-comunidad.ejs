<!DOCTYPE html>
<html lang="es">
<head>
    <%- include('../partials/head-inicio'); %>
    <link rel="stylesheet" href="/css/chat-comunidad.css">
</head>
<body class="cuerpo-chat">

    <div class="contenedor-principal-chat shadow">
        
        <!-- HEADER DEL CHAT (Con separación visual) -->
        <header class="header-chat d-flex align-items-center p-3">
            <a href="/comunidades" class="btn-interactivo me-2 text-decoration-none">
                <i class="bi bi-chevron-left" style="color: #8338ec; font-size: 1.5rem; -webkit-text-stroke: 1px;"></i>
            </a>
            
            <a href="/comunidades/<%= comunidad.id %>/info" class="d-flex align-items-center text-decoration-none flex-grow-1 seccion-info-header">
                <% if (comunidad.fotoSegura && comunidad.fotoSegura !== '/img/avatar.webp' && comunidad.fotoSegura !== '/img/default-comunidad.webp') { %>
                    <img src="<%= comunidad.fotoSegura %>" class="portada-chat-completa me-3" alt="Portada">
                <% } else { %>
                    <div class="portada-chat-placeholder me-3 d-flex align-items-center justify-content-center">
                        <i class="bi bi-people"></i>
                    </div>
                <% } %>
                <div class="info-header-chat">
                    <h5 class="m-0 titulo-comunidad-chat"><%= comunidad.nombre %></h5>
                </div>
            </a>
            
            <!-- Menú Desplegable -->
            <div class="dropdown">
                <button class="btn-interactivo dropdown-toggle-hide" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                    <i class="bi bi-three-dots-vertical" style="color: #8338ec; font-size: 1.5rem;"></i>
                </button>
                <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 mt-2 rounded-3">
                    <% if (estoyUnido && !esDueno) { %>
                        <li>
                            <!-- El botón ahora llama al modal sin que el dropdown lo bloquee -->
                            <button type="button" class="dropdown-item fw-semibold py-2 btn-abrir-modal-salir">
                                <i class="bi bi-box-arrow-right me-2" style="color: #8338ec;"></i> Salir de la comunidad
                            </button>
                        </li>
                    <% } else if (esDueno) { %>
                        <li>
                            <a class="dropdown-item text-secondary fw-semibold py-2" href="/comunidades/<%= comunidad.id %>/info">
                                <i class="bi bi-gear me-2"></i> Ajustes
                            </a>
                        </li>
                    <% } %>
                </ul>
            </div>
        </header>

        <!-- ÁREA DE MENSAJES -->
        <main class="area-mensajes-chat oculta-scroll p-3" id="contenedor-mensajes">
            <!-- La IA inyectará las burbujas dinámicas aquí -->
        </main>

        <!-- FOOTER: INPUT DE TEXTO (Con separación visual) -->
        <footer class="footer-chat p-2 px-3">
            <% if (estoyUnido) { %>
                <form id="form-chat" class="form-chat-alineado">
                    
                    <button type="button" class="btn-interactivo btn-adjuntar-icono">
                        <i class="bi bi-plus-circle-fill" style="color: #8338ec; font-size: 1.8rem;"></i>
                    </button>
                    
                    <!-- Contenedor con borde morado y sombra sutil -->
                    <div class="contenedor-input-blanco">
                        <textarea id="input-mensaje" class="form-control border-0 shadow-none oculta-scroll" 
                                  placeholder="Mensaje" rows="1"></textarea>
                    </div>
                    
                    <button type="submit" class="btn-interactivo btn-enviar-icono" id="btn-enviar-msg">
                        <i class="bi bi-send-fill text-muted" style="font-size: 1.5rem;"></i>
                    </button>
                </form>
            <% } else { %>
                <div class="text-center w-100 py-3 bg-white rounded-3 text-muted small fw-semibold shadow-sm border border-light">
                    Debes unirte a la comunidad para participar en el chat.
                </div>
            <% } %>
        </footer>

    </div>

    <!-- Modal Salir de la Comunidad (Colocado fuera del flujo para evitar problemas de z-index) -->
    <% if (estoyUnido && !esDueno) { %>
        <div class="modal fade" id="modalSalirComunidad" tabindex="-1" aria-hidden="true" data-bs-backdrop="true">
            <div class="modal-dialog modal-dialog-centered modal-sm">
                <div class="modal-content border-0 shadow-lg p-3 text-center rounded-4">
                    <h6 class="fw-bold mb-3 mt-2 text-dark">¿Salir de la comunidad?</h6>
                    <p class="small text-muted mb-4">Dejarás de recibir mensajes y deberás unirte de nuevo para participar.</p>
                    <form action="/comunidades/<%= comunidad.id %>/unirse" method="POST">
                        <div class="d-flex justify-content-center gap-2 mb-2">
                            <button type="button" class="btn btn-light btn-sm rounded-pill px-4 fw-semibold shadow-none" data-bs-dismiss="modal">Cancelar</button>
                            <button type="submit" class="btn btn-danger btn-sm rounded-pill px-4 fw-semibold shadow-none">Salir</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    <% } %>


    <script src="/js/chat-comunidad.js"></script>
</body>
</html>