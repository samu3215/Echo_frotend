                   <!-- 3. SEGURIDAD DE LA CUENTA -->
<div class="accordion-item item-configuracion">
    <h2 class="accordion-header">
        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapsePrivacidad">
            <div class="icono-item">
                <i class="bi bi-shield-lock"></i>
            </div>
            <div class="info-item">
                <span class="titulo-item">Seguridad de la Cuenta</span>
                <small class="subtitulo-item">Protección e inicio de sesión</small>
            </div>
        </button>
    </h2>
    <div id="collapsePrivacidad" class="accordion-collapse collapse" data-bs-parent="#acordeonConfiguracion">
        <div class="accordion-body">
            <p class="small text-muted m-0">
                Tu cuenta se encuentra protegida mediante autenticación encriptada JWT. Todos los datos de inicio de sesión y la información personal compartida en Echo están resguardados bajo estándares de seguridad para garantizar la integridad de tu perfil.
            </p>
        </div>
    </div>
</div>

             <!-- 4. INFORMACIÓN DE LA CUENTA (Adaptable: Normal vs Negocio) -->
<div class="accordion-item item-configuracion">
    <h2 class="accordion-header">
        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseCuenta">
            <div class="icono-item">
                <i class="bi bi-person"></i>
            </div>
            <div class="info-item">
                <span class="titulo-item">Información de la Cuenta</span>
                <small class="subtitulo-item">
                    <%= usuarioLogueado.es_negocio || usuarioLogueado.tipo_cuenta === 'negocio' ? 'Cuenta Comercial / Negocio' : 'Cuenta Personal' %>
                </small>
            </div>
        </button>
    </h2>
    <div id="collapseCuenta" class="accordion-collapse collapse" data-bs-parent="#acordeonConfiguracion">
        <div class="accordion-body body-info-cuenta">
            
            <!-- Alerta Informativa -->
            <div class="alert alert-info border-0 rounded-3 d-flex align-items-center mb-3 py-2 px-3 small" role="alert">
                <i class="bi bi-info-circle-fill me-2 fs-6"></i>
                <div>
                    Para modificar tu información personal, dirígete a tu 
                    <a href="/perfil/<%= usuarioLogueado.nombre_usuario || usuarioLogueado.username || '' %>" class="alert-link fw-bold">Apartado de Perfil</a>.
                </div>
            </div>

            <% 
                // Evaluar si es perfil comercial/negocio
                const esNegocio = usuarioLogueado.es_negocio || usuarioLogueado.tipo_cuenta === 'negocio' || !!usuarioLogueado.nombre_negocio;

                // Mapeo dinámico de campos
                const nombrePrincipal = esNegocio 
                    ? (usuarioLogueado.nombre_negocio || usuarioLogueado.razon_social || usuarioLogueado.nombre || 'No registrado')
                    : (usuarioLogueado.nombre || usuarioLogueado.first_name || 'No registrado');

                const segundoNombre = esNegocio 
                    ? (usuarioLogueado.categoria_negocio || usuarioLogueado.nit || 'Negocio')
                    : (usuarioLogueado.apellido || usuarioLogueado.last_name || 'No registrado');

                const usuario = usuarioLogueado.nombre_usuario || usuarioLogueado.username || 'No registrado';
                const telefono = usuarioLogueado.telefono || usuarioLogueado.celular || usuarioLogueado.phone || 'No registrado';
                const correo = usuarioLogueado.correo || usuarioLogueado.email || 'No registrado';
                const descripcion = usuarioLogueado.descripcion || usuarioLogueado.biografia || usuarioLogueado.bio || 'Sin descripción';
            %>

            <!-- Campos del Registro -->
            <div class="lista-detalles-cuenta">
                
                <div class="item-detalle-campo">
                    <span class="etiqueta-campo"><%= esNegocio ? 'Nombre del Negocio' : 'Nombre' %></span>
                    <p class="valor-campo"><%= nombrePrincipal %></p>
                </div>

                <div class="item-detalle-campo">
                    <span class="etiqueta-campo"><%= esNegocio ? 'Categoría / Tipo' : 'Apellido' %></span>
                    <p class="valor-campo"><%= segundoNombre %></p>
                </div>

                <div class="item-detalle-campo">
                    <span class="etiqueta-campo">Usuario</span>
                    <p class="valor-campo"><%= usuario !== 'No registrado' ? '@' + usuario : 'No registrado' %></p>
                </div>

                <div class="item-detalle-campo">
                    <span class="etiqueta-campo">Teléfono / Contacto</span>
                    <p class="valor-campo"><%= telefono %></p>
                </div>

                <div class="item-detalle-campo">
                    <span class="etiqueta-campo">Correo electrónico</span>
                    <p class="valor-campo"><%= correo %></p>
                </div>

                <div class="item-detalle-campo border-0">
                    <span class="etiqueta-campo">Descripción</span>
                    <p class="valor-campo m-0"><%= descripcion %></p>
                </div>

            </div>

        </div>
    </div>
</div>
 <!-- AYUDA Y SOPORTE -->
<div class="accordion-item item-configuracion">
    <h2 class="accordion-header">
        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseAyuda">
            <div class="icono-item">
                <i class="bi bi-exclamation-circle"></i>
            </div>
            <div class="info-item">
                <span class="titulo-item">Ayuda y Soporte</span>
                <small class="subtitulo-item">Obtén ayuda</small>
            </div>
        </button>
    </h2>
    <div id="collapseAyuda" class="accordion-collapse collapse" data-bs-parent="#acordeonConfiguracion">
        <div class="accordion-body body-ayuda-soporte">
          

            <!-- Tarjetas de Chat y Email -->
            <div class="grid-contacto-soporte">
                <a href="#" class="tarjeta-opcion-soporte">
                    <div class="icono-soporte morado">
                        <i class="bi bi-chat-square-text"></i>
                    </div>
                    <span class="nombre-opcion">Chat</span>
                    <small class="desc-opcion">+57 324 3931355</small>
                </a>

                <a href="mailto:soporte@echo.com" class="tarjeta-opcion-soporte">
                    <div class="icono-soporte morado">
                        <i class="bi bi-envelope"></i>
                    </div>
                    <span class="nombre-opcion">Enviar email</span>
                    <small class="desc-opcion">echocontactanos@innovamebusiness.com</small>
                </a>
            </div>

            <!-- Sección de Guías y tutoriales -->
            <div class="encabezado-guias">
                <i class="bi bi-bookmark-fill icono-verde"></i>
                <span class="titulo-guias">Guías y tutoriales</span>
            </div>

            <!-- Lista de guías -->
            <div class="lista-guias-soporte">
                <a href="#" class="item-guia-soporte">
                    <span class="titulo-guia">Guía de inicio para nuevos usuarios</span>
                    <small class="desc-guia">Aprende lo básico de Echo en 5 minutos</small>
                </a>

                <a href="#" class="item-guia-soporte">
                    <span class="titulo-guia">Cómo optimizar tu perfil de negocio</span>
                    <small class="desc-guia">Consejos para atraer más clientes</small>
                </a>

                <a href="#" class="item-guia-soporte">
                    <span class="titulo-guia">Crear y gestionar comunidades</span>
                    <small class="desc-guia">Todo lo que necesitas saber sobre comunidades</small>
                </a>

                <a href="#" class="item-guia-soporte">
                    <span class="titulo-guia">Privacidad y seguridad en Echo</span>
                    <small class="desc-guia">Protege tu información personal</small>
                </a>
            </div>

        </div>
    </div>
</div>


<!-- 5. TÉRMINOS Y CONDICIONES -->
<div class="accordion-item item-configuracion">
    <h2 class="accordion-header">
        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTerminos">
            <div class="icono-item">
                <i class="bi bi-file-earmark-text"></i>
            </div>
            <div class="info-item">
                <span class="titulo-item">Términos y Condiciones</span>
                <small class="subtitulo-item">Políticas de uso y privacidad</small>
            </div>
        </button>
    </h2>
    <div id="collapseTerminos" class="accordion-collapse collapse" data-bs-parent="#acordeonConfiguracion">
        <div class="accordion-body body-terminos">
            <p class="small text-muted mb-3">
                Al utilizar Echo, aceptas nuestras políticas de uso, privacidad y convivencia en la red social.
            </p>
            
            <!-- SUB-ACORDEÓN DESPLEGABLE -->
            <div class="accordion accordion-flush" id="subAcordeonTerminos">

                <!-- 1. TÉRMINOS DEL SERVICIO -->
                <div class="accordion-item border-0">
                    <h3 class="accordion-header">
                        <button class="accordion-button collapsed px-0 py-2 small fw-semibold text-body" type="button" data-bs-toggle="collapse" data-bs-target="#subCollapseServicio">
                            <span>Términos del Servicio</span>
                        </button>
                    </h3>
                    <div id="subCollapseServicio" class="accordion-collapse collapse" data-bs-parent="#subAcordeonTerminos">
                        <div class="accordion-body px-0 py-2 text-muted extra-small" style="font-size: 0.85rem; line-height: 1.5;">
                            <p>Bienvenido a <strong>Echo</strong>. Al registrarte como usuario común o perfil empresarial, aceptas los siguientes términos:</p>
                            <ul>
                                <li><strong>Cuentas Empresariales:</strong> La información sobre tu negocio (dirección, contacto, categoría) debe ser verídica. Queda prohibida la suplantación de marcas o establecimientos.</li>
                                <li><strong>Uso General:</strong> Echo proporciona una plataforma para conectar comercios locales con la comunidad. No nos hacemos responsables por las transacciones o acuerdos comerciales realizados fuera de la plataforma.</li>
                                <li><strong>Suspensión de Cuenta:</strong> Nos reservamos el derecho de desactivar perfiles que incurran en fraude, publicidad engañosa o incumplimiento recurrente de las normas.</li>
                            </ul>
                        </div>
                    </div>
                </div>

                <!-- 2. POLÍTICA DE PRIVACIDAD -->
                <div class="accordion-item border-0">
                    <h3 class="accordion-header">
                        <button class="accordion-button collapsed px-0 py-2 small fw-semibold text-body" type="button" data-bs-toggle="collapse" data-bs-target="#subCollapsePrivacidad">
                            <span>Política de Privacidad</span>
                        </button>
                    </h3>
                    <div id="subCollapsePrivacidad" class="accordion-collapse collapse" data-bs-parent="#subAcordeonTerminos">
                        <div class="accordion-body px-0 py-2 text-muted extra-small" style="font-size: 0.85rem; line-height: 1.5;">
                            <p>En Echo nos tomamos en serio la protección de tus datos personales:</p>
                            <ul>
                                <li><strong>Datos Recopilados:</strong> Guardamos datos de registro (correo, nombre de usuario, contraseña encriptada) y datos del perfil (descripción, foto, reseñas y datos de negocio si aplica).</li>
                                <li><strong>Visibilidad del Contenido:</strong> Todos los perfiles en Echo son públicos para fomentar el descubrimiento de negocios y la interacción en la comunidad. Las publicaciones, fotos y reseñas que compartas serán visibles para otros usuarios.</li>                                <li><strong>Uso de Información:</strong> No vendemos tu información personal a terceros. Los datos de reseñas y calificaciones son públicos dentro de la plataforma para beneficio de la comunidad.</li>
                            </ul>
                        </div>
                    </div>
                </div>

                <!-- 3. NORMAS DE LA COMUNIDAD -->
                <div class="accordion-item border-0">
                    <h3 class="accordion-header">
                        <button class="accordion-button collapsed px-0 py-2 small fw-semibold text-body" type="button" data-bs-toggle="collapse" data-bs-target="#subCollapseNormas">
                            <span>Normas de la Comunidad</span>
                        </button>
                    </h3>
                    <div id="subCollapseNormas" class="accordion-collapse collapse" data-bs-parent="#subAcordeonTerminos">
                        <div class="accordion-body px-0 py-2 text-muted extra-small" style="font-size: 0.85rem; line-height: 1.5;">
                            <p>Para mantener un ambiente constructivo en Echo, todos los usuarios deben seguir estas reglas:</p>
                            <ul>
                                <li><strong>Reseñas Auténticas y Respetuosas:</strong> Las opiniones sobre negocios deben basarse en experiencias reales. Quedan prohibidas las reseñas falsas para dañar o favorecer artificialmente la reputación de un establecimiento.</li>
                                <li><strong>Respeto en Comunidades:</strong> No se tolera el acoso, discurso de odio, spam o contenido explícito en las publicaciones o comentarios dentro de las comunidades.</li>
                                <li><strong>Moderación:</strong> Las reseñas o comentarios que contengan lenguaje ofensivo o difamatorio podrán ser reportados y eliminados por el equipo de moderación.</li>
                            </ul>
                        </div>
                    </div>
                </div>

            </div>

        </div>
    </div>
</div>

                        <!-- 6. IDIOMA -->
                        <div class="accordion-item item-configuracion">
                            <h2 class="accordion-header">
                                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseIdioma">
                                    <div class="icono-item">
                                        <i class="bi bi-globe"></i>
                                    </div>
                                    <div class="info-item">
                                        <span class="titulo-item">Idioma</span>
                                        <small class="subtitulo-item">Español</small>
                                    </div>
                                </button>
                            </h2>
                            <div id="collapseIdioma" class="accordion-collapse collapse" data-bs-parent="#acordeonConfiguracion">
                                <div class="accordion-body">
                                    <select class="form-select">
                                        <option value="es" selected>Español</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                    </div>


                  

                    <div class="acciones-inferiores-config">
                        <!-- Botón que activa el modal de Cerrar Sesión -->
                        <button type="button" class="btn btn-outline-danger w-100 btn-accion-borde" data-bs-toggle="modal" data-bs-target="#modalConfirmarLogout">
                            Cerrar sesión
                        </button>
                    
                        <!-- Botón que activa el modal de Eliminar Cuenta -->
                        <button type="button" class="btn btn-outline-danger w-100 btn-accion-borde mt-2" data-bs-toggle="modal" data-bs-target="#modalConfirmarEliminar">
                            Eliminar cuenta
                        </button>
                    </div>
                    
                    <!-- ==========================================
                         MODALES DE CONFIRMACIÓN (BOOTSTRAP)
                    ========================================== -->
                    
                    <!-- Modal Confirmar Cerrar Sesión -->
                    <div class="modal fade" id="modalConfirmarLogout" tabindex="-1" aria-labelledby="modalLogoutLabel" aria-hidden="true">
                        <div class="modal-dialog modal-dialog-centered">
                            <div class="modal-content modal-confirmacion-custom">
                                <div class="modal-header border-0 pb-0">
                                    <h5 class="modal-title fw-bold" id="modalLogoutLabel">¿Cerrar sesión?</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                </div>
                                <div class="modal-body text-muted">
                                    ¿Estás seguro de que deseas salir de tu cuenta? Tendrás que volver a ingresar tus credenciales para acceder.
                                </div>
                                <div class="modal-footer border-0 pt-0">
                                    <button type="button" class="btn btn-light btn-modal-cancelar" data-bs-dismiss="modal">Cancelar</button>
                                    <form action="/logout" method="POST" class="m-0">
                                        <button type="submit" class="btn btn-danger btn-modal-confirmar">Sí, cerrar sesión</button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Modal Confirmar Eliminar Cuenta -->
                    <div class="modal fade" id="modalConfirmarEliminar" tabindex="-1" aria-labelledby="modalEliminarLabel" aria-hidden="true">
                        <div class="modal-dialog modal-dialog-centered">
                            <div class="modal-content modal-confirmacion-custom">
                                <div class="modal-header border-0 pb-0">
                                    <h5 class="modal-title fw-bold text-danger" id="modalEliminarLabel">¿Eliminar cuenta?</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                </div>
                                <div class="modal-body text-muted">
                                    Esta acción es <strong>permanente y no se puede deshacer</strong>. Se borrarán todas tus publicaciones, fotos y datos asociados a esta cuenta.
                                </div>
                                <div class="modal-footer border-0 pt-0">
                                    <button type="button" class="btn btn-light btn-modal-cancelar" data-bs-dismiss="modal">Cancelar</button>
                                    <form action="/eliminar-cuenta" method="POST" class="m-0">
                                        <button type="submit" class="btn btn-danger btn-modal-confirmar">Sí, eliminar permanentemente</button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                <% } %>
            </div>
        </main>

    </div>
    <script src="/js/configuracion.js"></script>
</body>
</html>