<% if (typeof error !== 'undefined' && error) { %>
    <div class="alert alert-danger alert-dismissible fade show alerta-contenedor alerta-error" role="alert">
        <span class="alerta-texto"><%= error %></span>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
<% } %>

<% if (typeof exito !== 'undefined' && exito) { %>
    <div class="alert alert-success alert-dismissible fade show alerta-contenedor alerta-exito" role="alert">
        <span class="alerta-texto"><%= exito %></span>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
<% } %>