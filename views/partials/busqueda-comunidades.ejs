<div class="seccion-bloque">
    <% if (comunidades && comunidades.length > 0) { %>
        <% comunidades.forEach(comunidad => { %>
            <div class="tarjeta tarjeta-resultado d-flex align-items-center justify-content-between p-3 border rounded mb-2 bg-white">
                <a href="/comunidades/<%= comunidad.id %>" class="text-decoration-none text-dark flex-grow-1">
                    <span class="titulo fw-bold d-block"><%= comunidad.nombre %></span>
                    <small class="text-muted"><%= comunidad.descripcion || 'Sin descripción' %></small>
                </a>
                <button class="btn btn-outline-primary btn-sm">Unirse</button>
            </div>
        <% }); %>
    <% } else { %>
        <div class="mensaje-vacio">
            <i class="bi bi-people-fill display-4 text-muted mb-2 d-block"></i>
            <p class="text-muted fw-semibold m-0">No hay comunidades de momento</p>
        </div>
    <% } %>
</div>