<div class="card tarjeta-publicacion shadow-sm border-0 mb-4" data-post-id="<%= post.id %>">
    
    <div class="card-header bg-white border-0 d-flex justify-content-between align-items-center p-3">
        <div class="d-flex align-items-center">
            <a href="/perfil/<%= post.nombreAutorSeguro || 'Usuario' %>" class="text-decoration-none text-dark d-flex align-items-center">
                <img src="<%= post.fotoSegura %>" class="avatar-post rounded-circle shadow-sm me-2">
                <span class="fw-bold"><%= post.nombreAutorSeguro || 'Usuario' %></span>
            </a>
            <span class="text-muted ms-2 small fw-normal">• <%= post.fechaFormateada %></span>
        </div>

        <button class="btn btn-link text-dark p-0 btn-opciones-post shadow-none" 
                data-id="<%= post.id %>" 
                data-es-dueno="<%= post.esDueno %>"
                data-bs-toggle="modal" 
                data-bs-target="#modalOpcionesPost">
            <i class="bi bi-three-dots fs-5"></i>
        </button>
    </div>

    <!-- Carrusel: Con deslizamiento táctil forzado (data-bs-touch="true") -->
    <% if (post.archivos && post.archivos.length > 0) { %>
        <div id="carrusel-post-<%= post.id %>" class="carousel slide bg-oscuro-post position-relative" data-bs-touch="true" data-bs-ride="false" data-bs-wrap="false">
            <div class="carousel-inner">
                <% post.archivos.sort((a, b) => a.orden - b.orden).forEach((archivo, index) => { %>
                    <div class="carousel-item <%= index === 0 ? 'active' : '' %>">
                        <% if (archivo.tipo_media === 'video') { %>
                            <video src="<%= archivo.url_media %>" class="d-block w-100 media-post" autoplay muted loop playsinline></video>
                        <% } else { %>
                            <img src="<%= archivo.url_media %>" class="d-block w-100 media-post" alt="Media">
                        <% } %>
                    </div>
                <% }); %>
            </div>
            
            <% if (post.archivos.length > 1) { %>
                <div class="position-absolute top-0 end-0 m-2 bg-dark bg-opacity-75 text-white small px-2 py-1 rounded-pill z-3 indicador-carrusel" style="font-size: 0.75rem;">
                    1 / <%= post.archivos.length %>
                </div>

                <button class="carousel-control-prev d-none d-md-flex btn-prev-carrusel" type="button" data-bs-target="#carrusel-post-<%= post.id %>" data-bs-slide="prev">
                    <span class="carousel-control-prev-icon shadow-sm rounded-circle p-2 bg-dark bg-opacity-50"></span>
                </button>
                <button class="carousel-control-next d-none d-md-flex btn-next-carrusel" type="button" data-bs-target="#carrusel-post-<%= post.id %>" data-bs-slide="next">
                    <span class="carousel-control-next-icon shadow-sm rounded-circle p-2 bg-dark bg-opacity-50"></span>
                </button>
            <% } %>
        </div>
    <% } %>

    <div class="card-body p-3">
        <% if (post.descripcion) { %>
            <div class="descripcion-post mb-3 text-break small">
                <a href="/perfil/<%= post.nombreAutorSeguro %>" class="fw-bold text-dark text-decoration-none me-1"><%= post.nombreAutorSeguro %></a>
                <span class="text-dark"><%= post.descripcion %></span>
            </div>
        <% } %>

        <div class="d-flex align-items-start mb-2 mt-2">
            <% if (!post.esDueno) { %>
                <div class="d-flex flex-column align-items-center me-4">
                    <button class="btn btn-link text-dark p-0 btn-like text-decoration-none shadow-none" data-id="<%= post.id %>" title="Me gusta">
                        <i class="bi <%= post.tieneMiLike ? 'bi-heart-fill text-morado-echo' : 'bi-heart' %> fs-4 icono-like"></i>
                    </button>
                    <span class="fw-bold small mt-1 contador-likes" style="font-size: 0.8rem;"><%= post.likes_publicacion ? post.likes_publicacion.length : 0 %></span>
                </div>
            <% } %>

            <% if (post.comentarios_activados) { %>
                <div class="d-flex flex-column align-items-center me-4">
                    <button class="btn btn-link text-dark p-0 shadow-none text-decoration-none" title="Comentar" data-bs-toggle="modal" data-bs-target="#modalVerPost-<%= post.id %>">
                        <i class="bi bi-chat fs-4"></i>
                    </button>
                    <span class="fw-bold small mt-1 contador-comentarios cursor-pointer" style="font-size: 0.8rem;" data-bs-toggle="modal" data-bs-target="#modalVerPost-<%= post.id %>">
                        <%= (post.comentarios || post.comentarios_publicacion || []).length %>
                    </span>
                </div>
            <% } %>

            <div class="d-flex flex-column align-items-center">
                <button class="btn btn-link text-dark p-0 shadow-none text-decoration-none" title="Compartir">
                    <i class="bi bi-send fs-4"></i>
                </button>
            </div>
        </div>

        <% if (post.comentarios_activados) { %>
            <div class="text-muted small cursor-pointer border-top pt-2 mt-3" data-bs-toggle="modal" data-bs-target="#modalVerPost-<%= post.id %>">
                Ver todos los comentarios
            </div>
        <% } else { %>
            <div class="text-muted small border-top pt-2 mt-3">Los comentarios están desactivados.</div>
        <% } %>
    </div>
</div>

<div class="modal fade" id="modalVerPost-<%= post.id %>" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content bg-white text-dark flex-lg-row overflow-hidden shadow" style="height: 85vh; max-height: 85vh; border-radius: 12px;">
            
            <div class="w-lg-60 bg-black d-flex align-items-center justify-content-center position-relative">
                <% if (post.archivos && post.archivos.length > 0) { %>
                    <div id="carrusel-modal-<%= post.id %>" class="carousel slide w-100 h-100 d-flex align-items-center position-relative" data-bs-touch="true" data-bs-ride="false" data-bs-wrap="false">
                        <div class="carousel-inner h-100 d-flex align-items-center">
                            <% post.archivos.sort((a, b) => a.orden - b.orden).forEach((archivo, index) => { %>
                                <div class="carousel-item <%= index === 0 ? 'active' : '' %> w-100">
                                    <% if (archivo.tipo_media === 'video') { %>
                                        <video src="<%= archivo.url_media %>" class="d-block w-100 media-modal" autoplay muted loop playsinline controls></video>
                                    <% } else { %>
                                        <img src="<%= archivo.url_media %>" class="d-block w-100 media-modal" alt="Media">
                                    <% } %>
                                </div>
                            <% }); %>
                        </div>
                        <% if (post.archivos.length > 1) { %>
                            <div class="position-absolute top-0 end-0 m-2 bg-dark bg-opacity-75 text-white small px-2 py-1 rounded-pill z-3 indicador-carrusel" style="font-size: 0.75rem;">
                                1 / <%= post.archivos.length %>
                            </div>
                            <button class="carousel-control-prev d-none d-md-flex btn-prev-carrusel" type="button" data-bs-target="#carrusel-modal-<%= post.id %>" data-bs-slide="prev">
                                <span class="carousel-control-prev-icon"></span>
                            </button>
                            <button class="carousel-control-next d-none d-md-flex btn-next-carrusel" type="button" data-bs-target="#carrusel-modal-<%= post.id %>" data-bs-slide="next">
                                <span class="carousel-control-next-icon"></span>
                            </button>
                        <% } %>
                    </div>
                <% } else { %>
                    <div class="text-white text-center w-100">Publicación de solo texto</div>
                <% } %>
            </div>

            <div class="w-lg-40 d-flex flex-column bg-white border-start position-relative">
                
                <button type="button" class="btn-close position-absolute top-0 end-0 m-3 z-3 d-none d-lg-block" data-bs-dismiss="modal" aria-label="Close"></button>

                <div class="p-3 flex-grow-1 overflow-auto custom-scrollbar pt-5 mt-2">
                    
                    <% const comentariosLista = post.comentarios || post.comentarios_publicacion || []; %>
                    <% if (comentariosLista.length > 0) { %>
                        <% comentariosLista.forEach(comentario => { %>
                            <% 
                                let esMiComentario = false;
                                if (usuarioLogueado && comentario.usuario) {
                                    esMiComentario = (String(comentario.usuario.id) === String(usuarioLogueado.id) || comentario.usuario.nombre_usuario === usuarioLogueado.nombre_usuario);
                                }
                            %>
                            <div class="d-flex mb-3 contenedor-comentario-entero" id="caja-comentario-<%= comentario.id %>" data-post-id="<%= post.id %>">
                                <% const nomUsuario = (comentario.usuario && comentario.usuario.nombre_usuario) ? comentario.usuario.nombre_usuario : 'Usuario' %>
                                <a href="/perfil/<%= nomUsuario %>">
                                    <img src="<%= (comentario.usuario && comentario.usuario.foto_perfil) ? comentario.usuario.foto_perfil : '/img/avatar.webp' %>" class="avatar-post rounded-circle me-2 mt-1" style="width: 32px; height: 32px; object-fit: cover;">
                                </a>
                                <div class="bg-light p-2 rounded-3 w-100 position-relative">
                                    
                                    <% if (esMiComentario) { %>
                                        <button class="btn btn-link text-muted p-0 position-absolute top-0 end-0 m-2 shadow-none btn-abrir-opciones-com" data-id="<%= comentario.id %>">
                                            <i class="bi bi-three-dots"></i>
                                        </button>
                                    <% } %>

                                    <div class="vista-texto-comentario" id="vista-com-<%= comentario.id %>">
                                        <a href="/perfil/<%= nomUsuario %>" class="fw-bold text-dark text-decoration-none small mb-1 d-block pe-3"><%= nomUsuario %></a>
                                        
                                        <div class="small text-dark texto-comentario-real" data-contenido="<%= comentario.contenido %>"><%= comentario.contenido %></div>
                                    </div>

                                </div>
                            </div>
                        <% }); %>
                    <% } else { %>
                        <div class="text-center text-muted small mt-5 mensaje-sin-comentarios">Aún no hay comentarios. Sé el primero.</div>
                    <% } %>
                </div>

                <div class="p-3 border-top flex-shrink-0 mt-auto">
                    <div class="d-flex align-items-start mb-2">
                        <% if (!post.esDueno) { %>
                            <div class="d-flex flex-column align-items-center me-4">
                                <button class="btn btn-link text-dark p-0 btn-like shadow-none text-decoration-none" data-id="<%= post.id %>">
                                    <i class="bi <%= post.tieneMiLike ? 'bi-heart-fill text-morado-echo' : 'bi-heart' %> fs-4 icono-like"></i>
                                </button>
                            </div>
                        <% } %>
                        <div class="d-flex flex-column align-items-center me-4">
                            <button class="btn btn-link text-dark p-0 shadow-none text-decoration-none">
                                <i class="bi bi-chat fs-4"></i>
                            </button>
                        </div>
                        <div class="d-flex flex-column align-items-center">
                            <button class="btn btn-link text-dark p-0 shadow-none text-decoration-none">
                                <i class="bi bi-send fs-4"></i>
                            </button>
                        </div>
                    </div>
                    
                    <div class="fw-bold small mb-2 text-dark"><span class="contador-likes"><%= post.likes_publicacion ? post.likes_publicacion.length : 0 %></span> Me gusta</div>

                    <% if (post.comentarios_activados) { %>
                        <form class="form-comentario d-flex align-items-end mt-2 tarjeta-publicacion w-100 m-0" data-post-id="<%= post.id %>">
                            <textarea class="form-control text-dark border shadow-sm px-3 py-2 input-comentario flex-grow-1" placeholder="Agrega un comentario..." rows="1" style="resize: none; overflow: hidden; border-radius: 20px;"></textarea>
                            <button type="submit" class="btn btn-link fw-bold text-decoration-none p-0 ms-2 mb-1 btn-publicar-comentario text-morado-echo" disabled>Publicar</button>
                        </form>
                    <% } %>
                </div>
            </div>
        </div>
    </div>
</div>


<!-- 1. Modal Elegir Opciones -->
<div class="modal fade" id="modalOpcionesComentario" tabindex="-1" aria-hidden="true" data-bs-backdrop="false" style="background: rgba(0,0,0,0.5); z-index: 1060;">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content border-0 shadow">
            <div class="list-group list-group-flush text-center w-100">
                <button type="button" class="list-group-item list-group-item-action fw-semibold text-dark shadow-none" id="btn-modal-editar-com">
                    Editar comentario
                </button>
                <button type="button" class="list-group-item list-group-item-action fw-bold text-danger shadow-none" id="btn-modal-eliminar-com">
                    Eliminar comentario
                </button>
                <button type="button" class="list-group-item list-group-item-action text-muted shadow-none" id="btn-modal-cancelar-opciones">
                    Cancelar
                </button>
            </div>
        </div>
    </div>
</div>

<!-- 2. Modal Confirmar Eliminar -->
<div class="modal fade" id="modalConfirmarEliminarCom" tabindex="-1" aria-hidden="true" data-bs-backdrop="false" style="background: rgba(0,0,0,0.6); z-index: 1060;">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content border-0 shadow p-3 text-center">
            <h6 class="fw-bold mb-3 mt-2">¿Eliminar comentario?</h6>
            <p class="small text-muted mb-4">Esta acción no se puede deshacer.</p>
            <div class="d-flex justify-content-center gap-2 mb-2">
                <button type="button" class="btn btn-light btn-sm rounded-pill px-4 fw-bold shadow-none" id="btn-modal-cancelar-eliminar">Cancelar</button>
                <button type="button" class="btn btn-danger btn-sm rounded-pill px-4 fw-bold shadow-none" id="btn-modal-confirmar-eliminar">Eliminar</button>
            </div>
        </div>
    </div>
</div>

<!-- 3. Modal Editar Comentario (NUEVO) -->
<div class="modal fade" id="modalEditarComentario" tabindex="-1" aria-hidden="true" data-bs-backdrop="false" style="background: rgba(0,0,0,0.6); z-index: 1060;">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content border-0 shadow p-3">
            <h6 class="fw-bold mb-3 mt-1 text-center">Editar comentario</h6>
            <textarea class="form-control text-dark border shadow-sm px-3 py-2 mb-3" id="input-modal-editar-com" rows="2" style="resize: none; border-radius: 12px; font-size: 0.9rem;"></textarea>
            <div class="d-flex justify-content-end gap-2">
                <button type="button" class="btn btn-light btn-sm rounded-pill px-3 fw-semibold shadow-none" id="btn-modal-cancelar-editar">Cancelar</button>
                <button type="button" class="btn btn-sm text-white rounded-pill px-4 fw-bold shadow-none" style="background-color: #8338ec;" id="btn-modal-guardar-editar">Guardar</button>
            </div>
        </div>
    </div>
</div>