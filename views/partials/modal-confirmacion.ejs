<% [
  {
    id: 'modalConfirmacionCerrar',
    texto: '¿Estás seguro de que deseas cerrar sesión?',
    ruta: '/logout/'
  },
  {
    id: 'modalConfirmacionEliminar',
    texto: '¿Estás seguro de que deseas eliminar tu cuenta? Esta acción no se puede deshacer.',
    ruta: '/eliminar-cuenta'
  }
].forEach((confirmacion) => { %>
  <div class="modal fade modal-confirmacion" id="<%= confirmacion.id %>" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content modal-eliminar-content">
        <div class="modal-body modal-eliminar-body">
          <p class="modal-eliminar-texto"><%= confirmacion.texto %></p>

          <div class="modal-eliminar-acciones">
            <button type="button" class="btn btn-secondary btn-cancelar" data-bs-dismiss="modal">
              Cancelar
            </button>

            <!-- El formulario ejecuta la acción al confirmar -->
            <form action="<%= confirmacion.ruta %>" method="POST" style="margin: 0;">
              <button type="submit" class="btn btn-danger btn-eliminar">
                Confirmar
              </button>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>
<% }); %>