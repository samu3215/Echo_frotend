<div class="seccion-bloque">
    <% if (negocios && negocios.length > 0) { %>
        <% negocios.forEach(negocio => { %>
            <div class="tarjeta">
                <a href="/perfil/<%= negocio.nombre_usuario %>" class="enlace-usuario">
                    <div class="contenedor-avatar">
                        <img src="<%= negocio.foto_perfil || '/img/avatar.png' %>" class="avatar-busqueda" alt="Negocio">
                    </div>
                    <div class="info-usuario">
                        <span class="titulo text-truncate"><%= negocio.nombre_negocio || negocio.nombre %></span>
                        <small class="username text-truncate">@<%= negocio.nombre_usuario %></small>
                    </div>
                </a>
                <% if (usuarioLogueado && usuarioLogueado.nombre_usuario !== negocio.nombre_usuario) { %>
                    <button type="button" 
                        class="btn-accion-busqueda btn-seguir btn-seguir-generico <%= negocio.lo_sigo ? 'btn-siguiendo' : '' %>" 
                        data-usuario="<%= negocio.nombre_usuario %>">
                        <%= negocio.lo_sigo ? 'Siguiendo' : 'Seguir' %>
                    </button>
                <% } %>
            </div>
        <% }); %>
    <% } else { %>
        <p class="mensaje-vacio">No se encontraron negocios.</p>
    <% } %>
</div>