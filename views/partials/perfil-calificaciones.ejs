<div class="contenedor-publicaciones mt-3">
    <% if (usuarioPerfil.calificaciones_recibidas && usuarioPerfil.calificaciones_recibidas.length > 0) { %>
        <% usuarioPerfil.calificaciones_recibidas.forEach(calificacion => { %>
            <div class="tarjeta-publicacion p-3 mb-3 border rounded bg-white shadow-sm">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <h6 class="fw-bold m-0"><i class="bi bi-star-fill text-warning"></i> <%= calificacion.puntuacion || 0 %></h6>
                        
                        <p class="text-muted small mb-1">@<%= (calificacion.usuario_califica && calificacion.usuario_califica.nombre_usuario) ? calificacion.usuario_califica.nombre_usuario : 'Usuario' %></p>
                    </div>
                    
                    <% if (usuarioLogueado && calificacion.usuario_califica && usuarioLogueado.nombre_usuario === calificacion.usuario_califica.nombre_usuario) { %>
                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-sm btn-outline-primary btn-abrir-editar-resena" 
                                data-id="<%= calificacion.id %>"
                                data-puntuacion="<%= calificacion.puntuacion %>"
                                data-descripcion="<%= calificacion.descripcion || '' %>"
                                data-usuario-perfil="<%= usuarioPerfil.nombre_usuario %>">
                                <i class="bi bi-pencil"></i>
                            </button>

                            <form action="/perfil/<%= usuarioPerfil.nombre_usuario %>/calificaciones/<%= calificacion.id %>/eliminar" method="POST" class="m-0" onsubmit="return confirm('¿Seguro que deseas eliminar esta reseña?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                            </form>
                        </div>
                    <% } %>
                </div>
                <p class="mb-0 mt-2 text-break"><%= calificacion.descripcion || '' %></p>
            </div>
        <% }) %>
    <% } else { %>
        <div class="text-center mt-5 text-muted">
            <i class="bi bi-star fs-1 d-block mb-2"></i>
            <p>Aún no hay calificaciones registradas.</p>
        </div>
    <% } %>
</div>