<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.css">

<div class="modal fade" id="modalEditar" tabindex="-1" aria-labelledby="modalEditarLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-fullscreen-sm-down">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title fw-bold" id="modalEditarLabel">Editar Perfil</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      
      <form action="/perfil/<%= usuarioPerfil.nombre_usuario %>" method="POST" enctype="multipart/form-data" id="form-editar-perfil">
        <div class="modal-body">

          <%- include('../partials/alertas'); %>
          
          <!-- Vista del Avatar -->
          <div id="seccion-avatar-normal" class="mb-4 text-center">
              <div class="contenedor-avatar-edicion">
                <img id="vista-previa" 
                     src="<%= usuarioPerfil.foto_perfil || '/img/avatar.webp' %>" 
                     data-original-src="<%= usuarioPerfil.foto_perfil || '/img/avatar.webp' %>" 
                     class="imagen-avatar-previa shadow-sm">

                  <label for="foto_perfil" class="btn-subir-avatar" title="Cambiar foto">
                      <i class="bi bi-camera-fill"></i>
                  </label>
              </div>
              <input type="file" name="foto_perfil" id="foto_perfil" accept="image/*" class="d-none">

              <div id="contenedor-btn-quitar" class="mt-2 d-none">
                  <button type="button" id="btn-quitar-foto" class="btn btn-sm btn-outline-danger rounded-pill">
                      <i class="bi bi-trash-fill me-1"></i> Quitar foto nueva
                  </button>
              </div>
          </div>

          <!-- Módulo Editor/Recortador de Imagen -->
          <div id="seccion-editor-imagen" class="d-none mb-4">
              <p class="small fw-semibold text-center mb-2">Ajusta la imagen dentro del círculo:</p>
              <div class="contenedor-recorte-modal text-center">
                  <img id="imagen-para-recortar" src="" alt="Previsualización">
              </div>
              <div class="d-flex justify-content-center gap-2 mt-3">
                  <button type="button" id="btn-cancelar-recorte" class="btn btn-sm btn-secondary">Cancelar</button>
                  <button type="button" id="btn-confirmar-recorte" class="btn btn-sm btn-primary">Guardar</button>
              </div>
          </div>

          <% if (usuarioPerfil.tipo_usuario === 'empresarial') { %>
              <div class="mb-3">
                  <label class="form-label small fw-semibold">Nombre del Negocio</label>
                  <input type="text" name="nombre_negocio" class="form-control" value="<%= usuarioPerfil.nombre_negocio || '' %>">
              </div>
              <div class="mb-3">
                  <label class="form-label small fw-semibold">Dirección</label>
                  <input type="text" name="direccion" class="form-control" value="<%= usuarioPerfil.direccion || '' %>">
              </div>
          <% } else { %>
              <div class="mb-3">
                  <label class="form-label small fw-semibold">Nombre</label>
                  <input type="text" name="nombre" class="form-control" value="<%= usuarioPerfil.nombre || '' %>">
              </div>
              <div class="mb-3">
                  <label class="form-label small fw-semibold">Apellido</label>
                  <input type="text" name="apellido" class="form-control" value="<%= usuarioPerfil.apellido || '' %>">
              </div>
          <% } %>

          <div class="mb-3">
              <label class="form-label small fw-semibold">Usuario</label>
              <input type="text" name="nombre_usuario" class="form-control" value="<%= usuarioPerfil.nombre_usuario || '' %>">
          </div>

          <div class="mb-3">
              <label class="form-label small fw-semibold">Teléfono</label>
              <input type="text" name="telefono" class="form-control" value="<%= usuarioPerfil.telefono || '' %>">
          </div>

          <div class="mb-3">
              <label class="form-label small fw-semibold">Correo electrónico</label>
              <input type="email" name="email" class="form-control" value="<%= usuarioPerfil.email || '' %>">
          </div>

          <div class="mb-3">
              <label class="form-label small fw-semibold">Descripción</label>
              <textarea name="descripcion" class="form-control" rows="3"><%= usuarioPerfil.descripcion || '' %></textarea>
          </div>

          <hr class="my-4" style="border-color: #f1e8ff;">
          <h6 class="mb-3 fw-bold text-dark">Cambiar Contraseña</h6>
          
          <div class="mb-3">
              <label class="form-label small fw-semibold">Nueva Contraseña</label>
              <input type="password" name="password" class="form-control" placeholder="Dejar en blanco para no cambiar">
          </div>
          
          <div class="mb-3">
              <label class="form-label small fw-semibold">Confirmar Contraseña</label>
              <input type="password" name="confirmar_password" class="form-control" placeholder="Repite la nueva contraseña">
          </div>

        </div>
        
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
          <button type="submit" class="btn btn-primary">Guardar cambios</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.js"></script>