<div class="seccion-bloque">
    <% if (usuarios && usuarios.length > 0) { %>
        <% usuarios.forEach(usuario => { %>
            <div class="tarjeta">
                <a href="/perfil/<%= usuario.nombre_usuario %>" class="enlace-usuario">
                    <div class="contenedor-avatar">
                        <img src="<%= usuario.foto_perfil || '/img/avatar.png' %>" class="avatar-busqueda" alt="Avatar">
                    </div>
                    <div class="info-usuario">
                        <span class="titulo text-truncate"><%= usuario.nombre %> <%= usuario.apellido || '' %></span>
                        <small class="username text-truncate">@<%= usuario.nombre_usuario %></small>
                    </div>
                </a>
                <!-- <button
                    class="btn-accion-busqueda <%= usuario.esta_siguiendo ? 'activo' : '' %>"
                    data-usuario="<%= usuario.nombre_usuario %>"
                    data-siguiendo="<%= usuario.esta_siguiendo ? 'true' : 'false' %>"
                    <%= (!usuarioLogueado || usuarioLogueado.nombre_usuario === usuario.nombre_usuario) ? 'disabled' : '' %>
                >
                    <%= usuario.esta_siguiendo ? 'Siguiendo' : 'Seguir' %>
                </button> -->
            </div>
        <% }); %>
    <% } else { %>
        <p class="mensaje-vacio">No se encontraron usuarios.</p>
    <% } %>
</div>